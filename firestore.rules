rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper validation functions
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.-]+$');
    }

    function isReasonableSize() {
      return request.resource.data.keys().size() >= 1 && request.resource.data.keys().size() <= 60;
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isValidId(projectId) && isReasonableSize()
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 300));
      allow delete: if isValidId(projectId);
    }

    // Criteria collection
    match /criteria/{criterionId} {
      allow read: if true;
      allow create, update: if isValidId(criterionId) && isReasonableSize();
      allow delete: if isValidId(criterionId);
    }

    // Results collection
    match /results/{resultId} {
      allow read: if true;
      allow create, update: if isValidId(resultId) && isReasonableSize();
      allow delete: if isValidId(resultId);
    }

    // Files metadata collection
    match /files/{fileId} {
      allow read: if true;
      allow create, update: if isValidId(fileId) && isReasonableSize()
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 300));
      allow delete: if isValidId(fileId);
    }

    // Chunks collection
    match /chunks/{chunkId} {
      allow read: if true;
      allow create, update: if isValidId(chunkId) && isReasonableSize();
      allow delete: if isValidId(chunkId);
    }

    // Ratings feedback collection
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if isValidId(ratingId) && isReasonableSize()
        && (!('positive_rating' in request.resource.data) || request.resource.data.positive_rating is bool);
      allow delete: if isValidId(ratingId);
    }

    // Gemini evaluation audit records
    match /evaluations/{evaluationId} {
      allow read: if true;
      allow create, update: if isValidId(evaluationId) && isReasonableSize();
      allow delete: if isValidId(evaluationId);
    }

    // Compliance requirements checklist and audit records
    match /compliance_requirements/{reqId} {
      allow read: if true;
      allow create, update: if isValidId(reqId) && isReasonableSize()
        && (!('status' in request.resource.data) || request.resource.data.status in ['Compliant', 'In Progress', 'Flagged', 'Non-Compliant', 'Pending']);
      allow delete: if isValidId(reqId);
    }

    // Threaded team discussion comments for compliance items
    match /compliance_comments/{commentId} {
      allow read: if true;
      allow create, update: if isValidId(commentId) && isReasonableSize()
        && (!('content' in request.resource.data) || (request.resource.data.content is string && request.resource.data.content.size() <= 5000));
      allow delete: if isValidId(commentId);
    }

    // Global audit activity stream and bulk actions logging
    match /compliance_activities/{activityId} {
      allow read: if true;
      allow create, update: if isValidId(activityId) && isReasonableSize();
      allow delete: if isValidId(activityId);
    }

    // User active audit session and project selection
    match /user_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isValidId(sessionId) && isReasonableSize();
      allow delete: if isValidId(sessionId);
    }

    // Read-only health check probe path
    match /_connection_test_/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny for any unmapped shadow collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
